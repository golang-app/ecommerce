<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Payment failed for order {{.Order.ID}}</title>
</head>
<body style="font-family: -apple-system, Segoe UI, Roboto, sans-serif; color: #1d1d1f; line-height: 1.5; max-width: 560px; margin: 24px auto; padding: 0 16px;">
  <h1 style="font-size: 22px; font-weight: 600; color: #d70015;">Payment failed.</h1>
  <p>We were unable to process the payment for order <strong>{{.Order.ID}}</strong>.</p>

  {{if .Reason}}
    <p style="background: #fff2f2; border: 1px solid #ffd2d2; padding: 12px 16px; border-radius: 6px;">
      <strong>Reason:</strong> {{.Reason}}
    </p>
  {{end}}

  <table cellspacing="0" cellpadding="6" style="width: 100%; border-collapse: collapse; margin-top: 16px;">
    <thead>
      <tr style="text-align: left; border-bottom: 1px solid #d2d2d7;">
        <th>Item</th>
        <th style="text-align: right;">Qty</th>
        <th style="text-align: right;">Subtotal</th>
      </tr>
    </thead>
    <tbody>
      {{range $line := .Order.Items}}
        <tr style="border-bottom: 1px solid #f0f0f0;">
          <td>{{$line.ProductName}}</td>
          <td style="text-align: right;">{{$line.Quantity}}</td>
          <td style="text-align: right;">{{$line.LineTotalDisplay}} {{$line.PriceCurrency}}</td>
        </tr>
      {{end}}
    </tbody>
    <tfoot>
      <tr style="font-weight: 600; border-top: 1px solid #d2d2d7;">
        <td colspan="2" style="text-align: right;">Total</td>
        <td style="text-align: right;">{{.Order.TotalDisplay}} {{.Order.TotalCurrency}}</td>
      </tr>
    </tfoot>
  </table>

  <p style="margin-top: 24px;">Please visit your order page to retry your payment or select another payment method:</p>
  <p>
    <a href="{{.OrderURL}}" style="background: #0071e3; color: #fff; padding: 10px 18px; border-radius: 6px; text-decoration: none; display: inline-block; font-weight: 500;">Retry payment &rarr;</a>
  </p>

  <p style="font-size: 13px; color: #6e6e73; margin-top: 32px;">If you have questions, please reply to this email to contact {{.SiteName}} support.</p>
</body>
</html>
