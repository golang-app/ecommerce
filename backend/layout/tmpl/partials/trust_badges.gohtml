{{define "trust_badges"}}
<div class="trust-bar" role="region" aria-label="Product value guarantees">
  <div class="trust-item">
    <div class="trust-item__icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="16.5" y1="9.4" x2="7.55" y2="4.21"></line>
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
        <line x1="12" y1="22.08" x2="12" y2="12"></line>
      </svg>
    </div>
    <div class="trust-item__content">
      <h3 class="trust-item__title">Estimated Delivery</h3>
      <p class="trust-item__desc">Arrives in 2–4 business days • Orders before 2 PM ship today</p>
    </div>
  </div>
  <div class="trust-item">
    <div class="trust-item__icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="1 4 1 10 7 10"></polyline>
        <polyline points="23 20 23 14 17 14"></polyline>
        <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
      </svg>
    </div>
    <div class="trust-item__content">
      <h3 class="trust-item__title">Hassle-Free Returns</h3>
      <p class="trust-item__desc">Prepaid return label included • 30-day money-back guarantee</p>
    </div>
  </div>
  <div class="trust-item">
    <div class="trust-item__icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        <polyline points="9 12 11 14 15 10"></polyline>
      </svg>
    </div>
    <div class="trust-item__content">
      <h3 class="trust-item__title">2-Year Warranty</h3>
      <p class="trust-item__desc">Full replacement warranty included at no extra cost</p>
    </div>
  </div>
</div>
{{end}}
{{define "trust-badges"}}{{template "trust_badges" .}}{{end}}
