{{define "admin-nav"}}
<nav class="admin-nav">
  <div class="admin-nav__section">
    <div class="admin-nav__heading">General</div>
    <a href="/admin" class="admin-nav__link {{if eq .Active "dashboard"}}is-active{{end}}">
      <svg class="admin-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
      <span>dashboard</span>
    </a>
  </div>

  <div class="admin-nav__section">
    <div class="admin-nav__heading">Sales</div>
    <a href="/admin/orders" class="admin-nav__link {{if eq .Active "orders"}}is-active{{end}}">
      <svg class="admin-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      <span>orders</span>
    </a>
  </div>

