{{define "announcement_bar"}}
<aside class="announcement-bar" id="announcement-bar" role="region" aria-label="Announcement">
  <script>
    (function() {
      try {
        if (sessionStorage.getItem('dismissed_announcement_v1') === '1') {
          var bar = document.getElementById('announcement-bar');
          if (bar) bar.style.display = 'none';
        }
      } catch (e) {}
    })();
  </script>
  <div class="shell announcement-bar__inner">
    <div class="announcement-bar__content">
      {{if .TopAnnouncementBanners}}
        {{range $index, $b := .TopAnnouncementBanners}}
          {{if gt $index 0}}<span class="announcement-bar__divider" aria-hidden="true">•</span>{{end}}
          <span class="announcement-bar__item">
            {{if $b.Icon}}<span class="announcement-bar__icon" aria-hidden="true">{{$b.Icon}}</span>{{end}}
            {{if $b.LinkURL}}
              <a href="{{$b.LinkURL}}" class="announcement-bar__link">
                <span>{{$b.Title}}</span>{{if $b.Body}} <span>{{$b.Body}}</span>{{end}}{{if $b.LinkText}} <strong>{{$b.LinkText}}</strong>{{end}}
              </a>
            {{else}}
              <span>{{$b.Title}}</span>{{if $b.Body}} <span>{{$b.Body}}</span>{{end}}
            {{end}}
            {{if $b.PromoCode}}
              <span class="announcement-bar__code-wrap">
                <strong>{{$b.PromoCode}}</strong>
                <button type="button" class="announcement-bar__code-btn" onclick="copyAnnouncementPromo(this, '{{$b.PromoCode}}')">Copy Code</button>
              </span>
            {{end}}
          </span>
        {{end}}
      {{else}}
        <span class="announcement-bar__item announcement-bar__item--shipping">
          <span class="announcement-bar__icon" aria-hidden="true">🚚</span>
          <span>Free shipping on orders over $50</span>
        </span>
        <span class="announcement-bar__divider" aria-hidden="true">•</span>
        <span class="announcement-bar__item announcement-bar__item--promo">
          <span class="announcement-bar__icon" aria-hidden="true">🎟️</span>
          <span>Use code <strong>WELCOME10</strong> for 10% off</span>
          <button type="button" class="announcement-bar__code-btn" onclick="copyAnnouncementPromo(this, 'WELCOME10')">Copy Code</button>
        </span>
      {{end}}
    </div>
    <button type="button" class="announcement-bar__close" id="announcement-close-btn" aria-label="Dismiss announcement" onclick="dismissAnnouncementBar()">✕</button>
  </div>
  <script>
    function dismissAnnouncementBar() {
      try {
        sessionStorage.setItem('dismissed_announcement_v1', '1');
      } catch (e) {}
      var bar = document.getElementById('announcement-bar');
      if (bar) {
        bar.style.display = 'none';
      }
    }

    var copyAnnouncementTimeout;
    function copyAnnouncementPromo(btn, code) {
      function onSuccess() {
        if (!btn) return;
        btn.textContent = '✓ Copied!';
        btn.classList.add('is-copied');
        clearTimeout(copyAnnouncementTimeout);
        copyAnnouncementTimeout = setTimeout(function() {
          btn.textContent = 'Copy Code';
          btn.classList.remove('is-copied');
        }, 2000);
      }

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(code).then(onSuccess).catch(function() {
          fallbackCopyText(code, onSuccess);
        });
      } else {
        fallbackCopyText(code, onSuccess);
      }
    }

    function fallbackCopyText(text, cb) {
      var textArea = document.createElement('textarea');
      textArea.value = text;
      textArea.style.position = 'fixed';
      textArea.style.opacity = '0';
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      try {
        var successful = document.execCommand('copy');
        if (successful && cb) cb();
      } catch (err) {}
      document.body.removeChild(textArea);
    }
  </script>
</aside>
{{end}}
{{define "announcement-bar"}}{{template "announcement_bar" .}}{{end}}
