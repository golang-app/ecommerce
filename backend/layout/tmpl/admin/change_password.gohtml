{{define "title"}}Change Admin Password · Store Admin{{end}}
{{define "description"}}Choose a new password for your Store Admin account.{{end}}

{{define "main"}}
  <div class="admin-auth-heading">
    <h2>Change Your Password</h2>
    <p class="muted">
      Your admin account requires a password change before you can continue. Please pick a new password — at least 8 characters.
    </p>
  </div>

  <form class="form admin-auth-form" method="post" action="/admin/change-password">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <div class="field">
      <label for="acp-current">Current Password</label>
      <input id="acp-current" type="password" name="current_password" autocomplete="current-password" required>
    </div>

    <div class="field">
      <label for="acp-new">New Password</label>
      <input id="acp-new" type="password" name="new_password" autocomplete="new-password" required>
    </div>

    <div class="field">
      <label for="acp-confirm">Confirm New Password</label>
      <input id="acp-confirm" type="password" name="confirm_password" autocomplete="new-password" required>
    </div>

    <button type="submit" class="btn btn--block">Update Password</button>
  </form>
{{end}}
