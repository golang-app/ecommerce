{{define "title"}}Admin sign in · Store Admin{{end}}
{{define "description"}}Sign in to the Store Admin panel.{{end}}

{{define "main"}}
  <div class="admin-auth-heading">
    <h2>Admin Sign In</h2>
    <p class="muted">Enter your credentials to access the admin panel</p>
  </div>

  <form class="form admin-auth-form" method="post" action="/admin/login">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <div class="field">
      <label for="admin-login-email">Email</label>
      <input id="admin-login-email" type="email" name="email" autocomplete="email" required placeholder="admin@example.com">
    </div>

    <div class="field">
      <label for="admin-login-password">Password</label>
      <input id="admin-login-password" type="password" name="password" autocomplete="current-password" required placeholder="••••••••">
    </div>

    <button type="submit" class="btn btn--block">Sign In</button>
  </form>
{{end}}
