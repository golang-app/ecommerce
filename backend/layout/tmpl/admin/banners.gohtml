{{define "main"}}
  <div class="admin-page-head">
    <h2 class="account-card__title">banners</h2>
    <div class="admin-page-head__actions">
      <a href="/admin/banners/new" class="btn">+ new banner</a>
    </div>
  </div>

  {{if .Banners}}
    <table class="admin-table">
      <thead>
        <tr>
          <th>slot</th>
          <th>title</th>
          <th>display order</th>
          <th>status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{range $b := .Banners}}
          <tr>
            <td><code>{{$b.Slot}}</code></td>
            <td>
              <strong>{{$b.Title}}</strong>
              {{if $b.PromoCode}}<br><small class="muted">code: <code>{{$b.PromoCode}}</code></small>{{end}}
            </td>
            <td>{{$b.DisplayOrder}}</td>
            <td>
              <form method="post" action="/admin/banners/{{$b.ID}}/toggle">
                <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                <button type="submit" class="linkbtn">
                  {{if $b.IsActive}}
                    <span class="badge badge--success">active</span>
                  {{else}}
                    <span class="badge badge--muted">inactive</span>
                  {{end}}
                </button>
              </form>
            </td>
            <td class="admin-table__actions">
              <a href="/admin/banners/{{$b.ID}}/edit">edit</a>
              <form method="post" action="/admin/banners/{{$b.ID}}/delete"
                    onsubmit="return confirm('Delete this banner?');">
                <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                <button type="submit" class="linkbtn linkbtn--danger">delete</button>
              </form>
            </td>
          </tr>
        {{end}}
      </tbody>
    </table>
  {{else}}
    <p class="muted">no banners created yet.</p>
  {{end}}
{{end}}
