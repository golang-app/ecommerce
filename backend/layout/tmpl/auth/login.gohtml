{{define "title"}}Sign in · {{.SiteName}}{{end}}
{{define "description"}}Sign in to your {{.SiteName}} account.{{end}}

{{define "main"}}
  <h1 class="page-title">sign in</h1>

  {{if .DemoMode}}
  <div class="demo-credentials-box">
    <div class="demo-credentials-box__header">
      <span class="demo-credentials-box__badge">DEMO ACCOUNT</span>
    </div>
    <div class="demo-credentials-box__content">
      <div class="demo-credentials-box__row">
        <span class="demo-credentials-box__label">Email:</span>
        <code>customer@example.com</code>
      </div>
      <div class="demo-credentials-box__row">
        <span class="demo-credentials-box__label">Password:</span>
        <code>Customer123!</code>
      </div>
    </div>
  </div>
  {{end}}

  <form class="form" method="post" action="/auth/login">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <div class="field">
      <label for="login-email">email</label>
      <input id="login-email" type="email" name="email" autocomplete="email" required>
    </div>

    <div class="field">
      <label for="login-password">password</label>
      <input id="login-password" type="password" name="password" autocomplete="current-password" required>
    </div>

    <button type="submit" class="btn btn--block">sign in</button>

    <p class="form__aside">not a member? <a href="/auth/register">register</a></p>
    <p class="form__aside"><a href="/auth/forgot">forgot password?</a></p>
  </form>
{{end}}
